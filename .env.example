# Copiá este archivo a .env y completá los valores.
# El .gitignore cubre .env* así que no se commitea — pero nunca lo pegues en un issue.
#
# Usá .env y NO .env.local: los scripts de mantenimiento (npm run db:indexes,
# npm run db:smoke) leen .env explícitamente, mientras que Next.js lee los dos.

# Connection string de MongoDB Atlas (M0).
# Atlas > Database > Connect > Drivers. Acordate de:
#  - reemplazar <password> por la password real (URL-encodeada si tiene símbolos)
#  - permitir 0.0.0.0/0 en Network Access (Vercel no tiene IPs fijas en Hobby)
#
# ESTA forma (mongodb+srv://) es la que va en Vercel.
MONGODB_URI="mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Si en local te da "querySrv ECONNREFUSED", tu Node no puede resolver SRV.
# Leé docs/troubleshooting-dns.md: la salida es poner acá la forma seed-list
# (mongodb://host1:27017,host2:27017,.../?replicaSet=...) que no usa SRV, y
# guardar la de arriba en MONGODB_URI_SRV para acordarte de cuál va en Vercel.
# OJO: la seed-list hardcodea los hosts del shard; no la uses en producción.

# Nombre de la base dentro del cluster. Opcional, default: opensnaplb
MONGODB_DB="opensnaplb"

# Secreto compartido con el GitHub Action que dispara el sync.
# Generá uno con:  openssl rand -hex 32
CRON_SECRET="cambiame-por-un-valor-random-largo"

# --- Panel de admin (revisión de peticiones) ---
#
# Generá los dos valores de abajo de una sola vez con:
#   npm run admin:hash -- "tu clave de al menos 12 caracteres"
#
# La clave NO se guarda en ningún lado: lo que va acá es un hash scrypt, que no
# se puede revertir. Así una captura de las variables de entorno no entrega el
# acceso al panel.
#
# Sin estas variables el panel queda CERRADO (503), nunca abierto.
ADMIN_USER="admin"

# OJO con el formato: el hash usa ":" como separador, no "$".
# Next expande variables al leer .env, así que un "$" en el valor se interpreta
# como referencia y el hash llega mutilado — el login falla con "clave
# incorrecta" sin ninguna pista. No lo edites a mano.
ADMIN_PASSWORD_HASH="scrypt:...:..."

# Firma la cookie de sesión del panel. Cambiarlo cierra todas las sesiones
# abiertas, que es lo que querés si sospechás que se filtró.
ADMIN_SESSION_SECRET="cambiame-por-un-valor-random-largo"

# OPCIONAL — solo desarrollo local, y solo si tenés el DNS roto.
# Node resuelve el SRV de mongodb+srv:// con c-ares, no con el resolver del SO.
# En algunos Windows c-ares no lee la config de red y cae a 127.0.0.1, con lo
# que Atlas falla con "querySrv ECONNREFUSED" aunque el resto de internet ande.
# Si te pasa, poné acá los DNS de tu adaptador (Get-DnsClientServerAddress).
# En Vercel NO hace falta: si la variable no existe, no se toca nada.
# DNS_SERVERS="8.8.8.8,1.1.1.1"
